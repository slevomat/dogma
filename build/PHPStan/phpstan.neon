
includes:
    #- ../../vendor/phpstan/phpstan-strict-rules/rules.neon
    #- ../../vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - phpstan.conf.php

parameters:
    level: 9

    reportUnmatchedIgnoredErrors: true

    paths:
        - ../../src
        - ../../tests

    earlyTerminatingMethodCalls:
        Dogma\Check:
            - invalidClass

    ignoreErrors:
        # PHPStan's intl stub omits false from UConverter::convert(), which returns string|false.
        -
            message: '~Strict comparison using === between string and false will always evaluate to false~'
            path: "../../src/common/Str.php"

        # Existing pure APIs call value-object factories and shared helpers; without these, PHPStan 2 emits 881 purity diagnostics.
        -
            identifier: possiblyImpure.new
        -
            identifier: possiblyImpure.methodCall
        -
            identifier: possiblyImpure.functionCall
        -
            identifier: impure.propertyAssign
        -
            identifier: impure.functionCall
        -
            identifier: impure.methodCall
